{
  "schema_version": 1,
  "inventory": "STRUCTURE.md",
  "exclude": [
    "memory/*",
    "backups/*",
    "**/history/*",
    "**/archive/*",
    "**/__pycache__/*",
    "**/node_modules/*",
    "**/.gradle/*",
    "**/.terraform/*",
    "*.pyc",
    "*.pem",
    "*.key",
    "*.jks",
    "*.keystore"
  ],
  "rules": [
    {
      "patterns": [
        "templates/*",
        "src/assets/styles/*",
        "src/assets/scripts/*",
        "scripts/sync_site.py",
        "tests/*"
      ],
      "owners": [
        "DESIGN_GUIDELINES.md",
        "README.md"
      ]
    },
    {
      "patterns": [
        "src/*.html",
        "src/*.js",
        "src/*.css",
        "src/assets/*",
        "src/about/*",
        "src/experience/*",
        "src/notes/*",
        "src/workbench/*",
        "src/labs/*"
      ],
      "owners": [
        "README.md"
      ]
    },
    {
      "patterns": [
        ".github/*"
      ],
      "owners": [
        ".github/README.md"
      ]
    }
  ],
  "required_text": [
    {
      "path": "README.md",
      "text": "python3 scripts/sync_site.py --check"
    },
    {
      "path": "README.md",
      "text": "python3 -m http.server 4173 --bind 127.0.0.1"
    }
  ]
}
